# --- Core ---
APP_ENV=local                      # local | staging | production
APP_SECRET_KEY=change-me-32-bytes-min
APP_DEBUG=false

# --- Database (PostgreSQL by default; SQLite URL accepted for local/dev/tests) ---
DATABASE_URL=postgresql+asyncpg://tglegal:tglegal@localhost:5432/tglegal

# --- Redis (task queue; optional, in-memory queue used when unset) ---
REDIS_URL=redis://localhost:6379/0

# --- Session storage (sensitive) ---
SESSIONS_ROOT=./sessions
SESSION_FILE_ENCRYPTION_KEY=        # base64 32-byte key (generate: app security keygen)
EVIDENCE_ROOT=./evidence_store
BACKUP_ROOT=./backups
EXPORT_ROOT=./exports

# --- Telegram validation provider ---
TELEGRAM_PROVIDER=simulation        # simulation | telethon (telethon = health/auth checks only)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Capacity model (measured by benchmarks, not fixed limits) ---
CAPACITY_SESSION_CHECK_CONCURRENCY=5
CAPACITY_WORKER_COUNT=2
CAPACITY_QUEUE_MAX=10000
CAPACITY_TASK_TIMEOUT_SECONDS=60
CAPACITY_MAX_RETRIES=3
CAPACITY_BACKOFF_BASE_SECONDS=2
CAPACITY_BACKOFF_MAX_SECONDS=300
QUARANTINE_FAILURE_THRESHOLD=3

# --- Official submission (optional SMTP for single official recipient; manual by default) ---
SUBMISSION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
